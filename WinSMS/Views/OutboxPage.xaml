<Page
    x:Class="WinSMS.Views.OutboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinSMS.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Outbox" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadCommand}" Content="Refresh">
                <Button.Icon><FontIcon Glyph="&#xE72C;"/></Button.Icon>
            </Button>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Messages}"
                  SelectedItem="{x:Bind ViewModel.SelectedMessage, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SmsMessage">
                    <Grid Padding="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind PhoneNumber}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Body}" Opacity="0.7" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Timestamp}" Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center" Opacity="0.6"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7"
                   Visibility="{x:Bind ViewModel.StatusMessage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
    </Grid>
</Page>
