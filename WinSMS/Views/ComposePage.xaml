<Page
    x:Class="WinSMS.Views.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Margin="16">
        <StackPanel MaxWidth="600" Spacing="12">
            <TextBlock Text="New Message" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>

            <TextBlock Text="To"/>
            <TextBox PlaceholderText="e.g. +447700900000"
                     Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     InputScope="TelephoneNumber"/>

            <TextBlock Text="Message"/>
            <TextBox PlaceholderText="Type your message here..."
                     Text="{x:Bind ViewModel.MessageBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="150"
                     TextWrapping="Wrap"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Top"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock>
                    <Run Text="{x:Bind ViewModel.CharacterCount, Mode=OneWay}"/>
                    <Run Text=" characters"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="{x:Bind ViewModel.RemainingCharacters, Mode=OneWay}"/>
                    <Run Text=" remaining"/>
                </TextBlock>
                <TextBlock Visibility="{x:Bind ViewModel.MessageParts, Converter={StaticResource GreaterThanOneToVisibilityConverter}, Mode=OneWay}">
                    <Run Text="{x:Bind ViewModel.MessageParts, Mode=OneWay}"/>
                    <Run Text=" parts"/>
                </TextBlock>
            </StackPanel>

            <Button Command="{x:Bind ViewModel.SendCommand}"
                    Content="Send"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Left">
                <Button.Icon><FontIcon Glyph="&#xE724;"/></Button.Icon>
            </Button>

            <ProgressRing IsActive="{x:Bind ViewModel.IsSending, Mode=OneWay}" Width="24" Height="24"/>

            <InfoBar x:Name="StatusBar"
                     IsOpen="{x:Bind ViewModel.StatusMessage, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.SendSucceeded, Converter={StaticResource BoolToInfoBarSeverityConverter}, Mode=OneWay}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
