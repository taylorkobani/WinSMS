<Page
    x:Class="WinSMS.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinSMS.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Inbox" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Messages list + detail pane -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Message list -->
            <ListView x:Name="MessageList"
                      Grid.Column="0"
                      ItemsSource="{x:Bind ViewModel.Messages}"
                      SelectedItem="{x:Bind ViewModel.SelectedMessage, Mode=TwoWay}"
                      SelectionMode="Single"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,0,1,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SmsMessage">
                        <Grid Padding="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{x:Bind IsRead, Converter={StaticResource BoolToUnreadColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind PhoneNumber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Body}" Opacity="0.7" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Timestamp}" Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Message detail -->
            <Grid Grid.Column="1" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Visibility="{x:Bind ViewModel.SelectedMessage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedMessage.PhoneNumber, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedMessage.Timestamp, Mode=OneWay}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,8">
                    <TextBlock Text="{x:Bind ViewModel.SelectedMessage.Body, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.SelectedMessage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.SelectedMessage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                    <Button Command="{x:Bind ViewModel.MarkAsReadCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedMessage, Mode=OneWay}"
                            Content="Mark as Read"/>
                    <Button Command="{x:Bind ViewModel.DeleteMessageCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedMessage, Mode=OneWay}"
                            Content="Delete"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status / loading -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7"
                   Visibility="{x:Bind ViewModel.StatusMessage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
    </Grid>
</Page>
