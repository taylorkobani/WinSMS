<Page
    x:Class="WinSMS.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinSMS.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Conversations" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="Refresh"/></StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListView x:Name="MessageList" Grid.Column="0" ItemsSource="{x:Bind ViewModel.Conversations}"
                      SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=TwoWay}" SelectionMode="Single"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SmsConversation">
                        <StackPanel Padding="4" Spacing="2">
                            <TextBlock Text="{x:Bind PhoneNumber}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind LastMessage.Body, Mode=OneWay}" Opacity="0.7" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind LastMessage.Timestamp, Mode=OneWay}" Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Column="1" Padding="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.SelectedConversation.PhoneNumber, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Visibility="{x:Bind ViewModel.SelectedConversation, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
                <ListView Grid.Row="1" Margin="0,8" ItemsSource="{x:Bind ViewModel.SelectedConversation.Messages, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SmsMessage">
                            <StackPanel Margin="4" Padding="10" MaxWidth="520">
                                <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Direction}" Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind Timestamp}" Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind Status}" Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnSpacing="8"
                      Visibility="{x:Bind ViewModel.SelectedConversation, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             PlaceholderText="Type a message..."
                             Text="{x:Bind ViewModel.ReplyBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="44"
                             MaxHeight="120"/>
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.SendReplyCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE724;"/>
                            <TextBlock Text="Send"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button Content="Mark Conversation as Read"
                            Command="{x:Bind ViewModel.MarkConversationAsReadCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SelectedConversation, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
                    <Button Content="Delete Conversation"
                            Command="{x:Bind ViewModel.DeleteConversationCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SelectedConversation, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsSending, Mode=OneWay}" Width="20" Height="20"/>
                </StackPanel>
            </Grid>
        </Grid>
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7"
                   Visibility="{x:Bind ViewModel.StatusMessage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
    </Grid>
</Page>
