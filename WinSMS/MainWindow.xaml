<Window
    x:Class="WinSMS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinSMS">

    <NavigationView x:Name="NavView"
                    IsSettingsVisible="True"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    SelectionChanged="NavView_SelectionChanged"
                    Loaded="NavView_Loaded">
        <NavigationView.PaneHeader>
            <Border x:Name="PhoneProfilePill"
                    Padding="10,4"
                    Margin="0,4,0,8"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <TextBlock x:Name="PhoneProfileName"
                           Foreground="White"
                           FontWeight="SemiBold"/>
            </Border>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Inbox" Tag="Inbox">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE715;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="New Message" Tag="Compose">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70F;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <Frame x:Name="ContentFrame"/>
        </NavigationView.Content>
    </NavigationView>
</Window>
