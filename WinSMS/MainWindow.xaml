<Window
    x:Class="WinSMS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinSMS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="12,0"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="WinSMS"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <Border x:Name="PhoneProfilePill"
                        Padding="10,3"
                        CornerRadius="12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="PhoneProfileName"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="SmsNotification"
                Grid.RowSpan="2"
                Width="380"
                Padding="16"
                Margin="0,0,20,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#FFF4B8"
                BorderBrush="#D69E00"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed"
                Canvas.ZIndex="100">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="New SMS"
                                   Foreground="#201A00"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SmsNotificationNumber"
                                   Foreground="#201A00"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            Background="Transparent"
                            Foreground="#201A00"
                            Click="SmsNotificationDismiss_Click"
                            ToolTipService.ToolTip="Dismiss"/>
                </Grid>
                <Button Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Click="SmsNotification_Click">
                    <TextBlock x:Name="SmsNotificationBody"
                               Foreground="#201A00"
                               TextWrapping="Wrap"
                               MaxLines="4"
                               TextTrimming="CharacterEllipsis"/>
                </Button>
            </Grid>
        </Border>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        IsPaneOpen="False"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Conversations" Tag="Inbox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="New Message" Tag="Compose">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="Profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame"/>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
