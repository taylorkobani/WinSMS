<Window
    x:Class="WinSMS.SmsNotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FFF4B8"
            BorderBrush="#D69E00"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="New SMS" Foreground="#201A00" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SenderText" Foreground="#201A00" FontWeight="Bold"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                        Background="Transparent" Foreground="#201A00"
                        Click="Dismiss_Click"/>
            </Grid>
            <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Click="Notification_Click">
                <TextBlock x:Name="BodyText" Foreground="#201A00" TextWrapping="Wrap"
                           MaxLines="5" TextTrimming="CharacterEllipsis"/>
            </Button>
        </Grid>
    </Border>
</Window>