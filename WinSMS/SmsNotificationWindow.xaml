<Window
    x:Class="WinSMS.SmsNotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Tapped="Notification_Tapped">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="New SMS" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SenderText" FontWeight="Bold"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                        Background="Transparent"
                        Click="Dismiss_Click"/>
            </Grid>
            <TextBlock Grid.Row="1"
                       x:Name="BodyText"
                       TextWrapping="Wrap"
                       MaxLines="5"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>